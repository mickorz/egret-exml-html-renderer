<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="SampleSkin" width="300" height="200" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*" states="normal,disabled">
	<w:Config id="cfg1"></w:Config>
	<e:Group id="root" x="10" y="10" width="280" height="180">
		<e:Image id="bg" source="hero_png" x="0" y="0" width="64" height="64" alpha="0.5"/>
		<e:Image id="frame" source="atlas_json.frame_one_png" x="80" y="0" width="32" height="32" scale9Grid="2,2,4,4"/>
		<e:Image id="trim" source="atlas_json.frame_trim_png" x="120" y="0"/>
		<e:Label id="title" text="Hello Egret" x="0" y="70" size="24" textColor="0xFF8800" bold="true" fontFamily="Microsoft YaHei"/>
		<e:Label id="centered" text="center" horizontalCenter="0" verticalCenter="0" size="16" textColor="0xFFFFFF"/>
		<e:Rect id="badge" x="0" y="120" width="100" height="30" fillColor="0x3355aa" fillAlpha="0.6" strokeColor="0xff0000" strokeWeight="2" ellipseWidth="16" ellipseHeight="16"/>
		<e:Button id="btn" x="130" y="100" width="120" height="40">
			<e:skinName>
				<e:Skin states="up,down,disabled">
					<e:Image width="100%" height="100%" source="atlas_json.frame_two_png"/>
					<e:Label id="labelDisplay" text="OK" horizontalCenter="0" verticalCenter="0" size="18" textColor="0xffffff"/>
				</e:Skin>
			</e:skinName>
		</e:Button>
		<ns1:CustomWidget id="custom1" x="0" y="160" width="50" height="20"/>
		<e:Image id="stated" source="hero_png" x="200" y="0" visible.disabled="false" scaleX.down="1.2"/>
		<e:Image id="missing" source="not_exist_png" x="200" y="150" width="20" height="20"/>
	</e:Group>
</e:Skin>
